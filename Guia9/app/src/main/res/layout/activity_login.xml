<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="32dp" android:gravity="center_vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="20sp" android:gravity="center" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/login" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/login_ayuda" />
        <EditText android:id="@+id/txtNick" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:layout_marginTop="24dp" android:hint="@string/nick" android:inputType="textVisiblePassword"
            android:singleLine="true" android:maxLength="50" android:autofillHints="username" />
        <EditText android:id="@+id/txtContrasena" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:hint="@string/contrasena" android:inputType="textPassword" android:maxLength="128"
            android:autofillHints="password" />

        <TextView android:id="@+id/estadoLogin" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="?attr/colorError" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/progresoLogin" android:layout_width="40dp"
            android:layout_height="40dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
        <Button android:id="@+id/btnIngresar" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/ingresar" />
        <Button android:id="@+id/btnRegistrarse" style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/registrarse" />
    </LinearLayout>
</ScrollView>
