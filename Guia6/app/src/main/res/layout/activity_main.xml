<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:onClick="onClickFrame"
        android:text="Frame Layout"
        android:textAllCaps="false"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp" />
    <Button
        android:id="@+id/btnLinear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:onClick="onClickLinear"
        android:text="Linear Layout"
        android:textAllCaps="false"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"/>
    <Button
        android:id="@+id/btnRelative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:onClick="onClickRelative"
        android:text="Relative Layout"
        android:textAllCaps="false"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"/>
    <Button
        android:id="@+id/btnTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:onClick="onClickTable"
        android:text="Table Layout"
        android:textAllCaps="false"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"/>
    <Button
        android:id="@+id/btnConstraint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:onClick="onClickContraint"
        android:text="Contraint Layout"
        android:textAllCaps="false"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"/>
    <Button
        android:id="@+id/btnGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:onClick="onClickGrid"
        android:text="Grid Layout"
        android:textAllCaps="false"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"/>
    <Button
        android:id="@+id/btnRegistro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:onClick="onClickRegistro"
        android:text="Registro de Usuario (4 Layouts)"
        android:textAllCaps="false"
        android:backgroundTint="@color/brand_primary"
        android:textColor="@color/white"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"/>
</LinearLayout>